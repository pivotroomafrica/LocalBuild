# Copy this file to .env.local and fill in values from the PIVOTROOM-DEMO
# Supabase project (Project Settings -> API). Never commit .env.local.

# Public — safe for browser/client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Must never be exposed to the browser/client.
# Not required for Phase 1 (profile creation uses a database trigger),
# reserved for future admin/server-only operations -- and used by the
# Playwright E2E suite (e2e/fixtures/supabase-admin.ts) for test-fixture
# provisioning/cleanup and deterministic time-travel. See e2e/README.md.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 — manual bank-transfer details shown on the payment page.
# Server-only (no NEXT_PUBLIC_ prefix): read in Server Components/Actions
# only, never bundled to the client. None of these are secret — they are
# what a customer transfers money to — but they belong in configuration,
# not source (lib/payment/bankConfig.ts). All four fall back to clearly
# labeled demo placeholders when unset, so the app works out of the box
# in this demo project.
PIVOTROOM_BANK_NAME=
PIVOTROOM_BANK_ACCOUNT_NAME=
PIVOTROOM_BANK_ACCOUNT_NUMBER=
PIVOTROOM_BANK_INSTRUCTIONS=

# Playwright E2E suite (e2e/) — deterministic test-fixture account
# credentials. All optional: each has a fixed, working default (see
# e2e/fixtures/env.ts) so the suite runs out of the box against a fresh
# copy of the demo project. Override here only if you need different
# accounts (e.g. a shared CI project where these emails already exist for
# another purpose). Never commit real values for these beyond this
# placeholder file — see e2e/README.md.
TEST_CUSTOMER_A_EMAIL=
TEST_CUSTOMER_A_PASSWORD=
TEST_CUSTOMER_B_EMAIL=
TEST_CUSTOMER_B_PASSWORD=
TEST_EXPERT_A_EMAIL=
TEST_EXPERT_A_PASSWORD=
TEST_EXPERT_B_EMAIL=
TEST_EXPERT_B_PASSWORD=
# TEST_ADMIN must already have profiles.role = 'admin' set manually in
# the target Supabase project — see e2e/README.md.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_DUAL_IDENTITY_EMAIL=
TEST_DUAL_IDENTITY_PASSWORD=
PLAYWRIGHT_BASE_URL=

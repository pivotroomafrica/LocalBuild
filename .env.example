# Copy this file to .env.local and fill in values from the PIVOTROOM-DEMO
# Supabase project (Project Settings -> API). Never commit .env.local.

# Public — safe for browser/client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Must never be exposed to the browser/client.
# Not required for Phase 1 (profile creation uses a database trigger),
# reserved for future admin/server-only operations.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 — manual bank-transfer details shown on the payment page.
# Server-only (no NEXT_PUBLIC_ prefix): read in Server Components/Actions
# only, never bundled to the client. None of these are secret — they are
# what a customer transfers money to — but they belong in configuration,
# not source (lib/payment/bankConfig.ts). All four fall back to clearly
# labeled demo placeholders when unset, so the app works out of the box
# in this demo project.
PIVOTROOM_BANK_NAME=
PIVOTROOM_BANK_ACCOUNT_NAME=
PIVOTROOM_BANK_ACCOUNT_NUMBER=
PIVOTROOM_BANK_INSTRUCTIONS=
